# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API, or `supabase projects api-keys --project-ref <ref>`.
#
# Both values are safe to expose to the browser. The anon key only grants what
# the row level security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Posts an embed to Discord whenever a part is requested; leave it
# unset to disable notifications.
#
# This one is a credential - anyone holding the URL can post to the channel.
# Keep it out of version control and do NOT add a NEXT_PUBLIC_ prefix, which
# would bundle it into the client where anyone could read it.
DISCORD_REQUEST_WEBHOOK_URL=
