# Copy to .env.local and fill in.
#
# None of these carry a NEXT_PUBLIC_ prefix, and that is deliberate: the
# prefix is what inlines a value into the client bundle where anyone can read
# it. Every value below is a server-only secret.

# Supabase: Project Settings -> API, or
# `supabase projects api-keys --project-ref <ref>`.
#
# The service role key bypasses row level security completely. The database
# has RLS enabled with no policies, so this key is the only way in - guard it
# like a database password and never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Posts an embed to Discord whenever a part is requested; leave it
# unset to disable notifications.
#
# Also a credential: anyone holding the URL can post to the channel.
DISCORD_REQUEST_WEBHOOK_URL=
